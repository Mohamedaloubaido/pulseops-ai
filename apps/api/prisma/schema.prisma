generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  RESPONDER
  VIEWER
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum MonitorStatus {
  UNKNOWN
  UP
  DOWN
}

enum AiArtifactType {
  INCIDENT_ANALYSIS
  POSTMORTEM
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String
  passwordHash     String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  sessions         Session[]
  memberships      Membership[]
  createdIncidents Incident[]       @relation("IncidentCreator")
  incidentUpdates  IncidentUpdate[] @relation("IncidentUpdateAuthor")
  aiArtifacts      AiArtifact[]     @relation("AiArtifactCreator")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id                    String       @id @default(cuid())
  name                  String
  slug                  String       @unique
  statusPageEnabled     Boolean      @default(false)
  statusPageTitle       String?
  statusPageDescription String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  memberships           Membership[]
  services              Service[]
  incidents             Incident[]
  incidentEmbeddings    IncidentEmbedding[]
}

model Membership {
  id             String           @id @default(cuid())
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userId         String
  organizationId String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Service {
  id             String            @id @default(cuid())
  name           String
  slug           String
  description    String?
  status         ServiceStatus     @default(OPERATIONAL)
  displayOrder   Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incidents      IncidentService[]
  monitors       Monitor[]

  @@unique([organizationId, slug])
  @@index([organizationId, displayOrder])
  @@index([organizationId, status])
}

model Monitor {
  id                  String         @id @default(cuid())
  name                String
  url                 String
  intervalSeconds     Int            @default(60)
  timeoutMs           Int            @default(5000)
  expectedStatus      Int            @default(200)
  enabled             Boolean        @default(true)
  lastStatus          MonitorStatus  @default(UNKNOWN)
  lastCheckedAt       DateTime?
  lastResponseTimeMs  Int?
  consecutiveFailures Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  serviceId           String
  service             Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  checks              MonitorCheck[]

  @@index([serviceId, enabled])
  @@index([enabled, lastCheckedAt])
}

model MonitorCheck {
  id             String        @id @default(cuid())
  status         MonitorStatus
  statusCode     Int?
  responseTimeMs Int?
  error          String?
  checkedAt      DateTime      @default(now())
  monitorId      String
  monitor        Monitor       @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
}

model Incident {
  id             String            @id @default(cuid())
  title          String
  summary        String?
  severity       IncidentSeverity
  status         IncidentStatus    @default(INVESTIGATING)
  startedAt      DateTime          @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organizationId String
  createdById    String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("IncidentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  services       IncidentService[]
  updates        IncidentUpdate[]
  aiArtifacts    AiArtifact[]
  embedding      IncidentEmbedding?

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model IncidentService {
  incidentId String
  serviceId  String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([incidentId, serviceId])
  @@index([serviceId])
}

model IncidentUpdate {
  id         String          @id @default(cuid())
  message    String
  status     IncidentStatus?
  createdAt  DateTime        @default(now())
  incidentId String
  authorId   String
  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author     User            @relation("IncidentUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
}

model AiArtifact {
  id           String         @id @default(cuid())
  type         AiArtifactType
  payload      Json
  model        String
  responseId   String?
  createdAt    DateTime       @default(now())
  incidentId   String
  createdById  String
  incident     Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdBy    User           @relation("AiArtifactCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([incidentId, type, createdAt])
}

model IncidentEmbedding {
  id             String       @id @default(cuid())
  incidentId     String       @unique
  organizationId String
  model          String
  dimensions     Int
  contentHash    String
  embedding      Float[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  incident       Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, model])
  @@index([organizationId, updatedAt])
}
